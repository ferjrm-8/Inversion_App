rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolios synced via user account identifier / private sync key
    match /portfolios/{portfolioId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
    
    // User collections
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}

